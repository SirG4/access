# ==============================================================================
# Access Portal — Lightweight Development Base Image (CPU / Fast Download)
# Ubuntu 22.04 + OpenSSH + Python 3.10 + Lightweight CPU PyTorch & Data Science
# ==============================================================================
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PATH="/usr/local/bin:${PATH}"

# Copy Astral uv package installer from official image for ultra-fast dependency resolution & installs
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 1. Install essential system utilities, networking tools, process managers
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    openssh-server \
    sudo \
    curl \
    wget \
    git \
    nano \
    vim \
    htop \
    btop \
    iputils-ping \
    iproute2 \
    net-tools \
    dnsutils \
    procps \
    tmux \
    screen \
    unzip \
    zip \
    rsync \
    tree \
    less \
    ca-certificates \
    bash \
    build-essential \
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# 2. Pre-install CPU-only PyTorch + Core Data Science & Jupyter packages via fast Astral uv installer
# Download size is ~180MB for CPU torch vs ~2.5GB for CUDA 12.4 torch
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --no-cache \
        torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu && \
    uv pip install --system --no-cache \
        numpy \
        scipy \
        pandas \
        matplotlib \
        seaborn \
        scikit-learn \
        jupyterlab \
        notebook \
        ipython

# 3. Configure OpenSSH Daemon
RUN mkdir -p /run/sshd && chmod 0755 /run/sshd

RUN sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config 2>/dev/null || true \
    && sed -i 's/PasswordAuthentication no/PasswordAuthentication yes/' /etc/ssh/sshd_config 2>/dev/null || true \
    && sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin no/' /etc/ssh/sshd_config 2>/dev/null || true \
    && sed -i 's/PermitRootLogin yes/PermitRootLogin no/' /etc/ssh/sshd_config 2>/dev/null || true

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 22

ENTRYPOINT ["/entrypoint.sh"]
